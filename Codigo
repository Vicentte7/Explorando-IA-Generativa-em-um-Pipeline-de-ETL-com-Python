import os
import time
import pandas as pd
import pymongo
from google import genai
from google.genai import types

# ==========================================
# 1. EXTRACT (Extração de Dados)
# ==========================================

# Caminho relativo para a planilha CSV
caminho_da_planilha = "UserID.csv"
df = pd.read_csv(caminho_da_planilha)

user_ids = df["UserID"].tolist()
print("IDs lidos do ficheiro CSV:", user_ids)

# String de conexão configurada via variável de ambiente ou placeholder
URI = os.getenv("MONGODB_URI", "mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/")
cliente = pymongo.MongoClient(URI)
cliente.admin.command('ping')
print("Ligação ao MongoDB estabelecida com sucesso!")

# Seleção da base de dados e da coleção
banco = cliente['clientes']
colecao = banco['clientes']

# Busca dos clientes correspondentes na coleção
users = []
for user_id in user_ids:
    user = colecao.find_one({"id": int(user_id)})
    if user:
        users.append(user)
    else:
        print(f"Utilizador com UserID {user_id} não foi encontrado no MongoDB.")

print(f"\nTotal de utilizadores carregados para o ETL: {len(users)}\n")

# ==========================================
# 2. TRANSFORM (Transformação com Gemini)
# ==========================================

# Chave de API lida de variável de ambiente ou placeholder
gemini_api_key = os.getenv("GEMINI_API_KEY", "SUA_CHAVE_API_AQUI")
gemini_client = genai.Client(api_key=gemini_api_key)

def gerar_mensagem_marketing(nome_cliente):
    prompt = (
        f"Você é um especialista em marketing bancário. "
        f"Crie uma mensagem curta para {nome_cliente} sobre a importância dos investimentos (máximo de 100 caracteres)."
    )
    try:
        resposta = gemini_client.models.generate_content(
            model="gemini-3.8-flash",
            contents=prompt,
            config=types.GenerateContentConfig(
                http_options=types.HttpOptions(timeout=15000)
            )
        )
        return resposta.text.strip().replace('"', '')
    except Exception as erro:
        print(f"Aviso: Erro ao chamar IA para {nome_cliente}: {erro}")
        return f"{nome_cliente}, invista no seu futuro com rentabilidade e segurança."

# Processamento de cada cliente encontrado
for user in users:
    print(f"A processar mensagem para {user['name']}...")
    mensagem = gerar_mensagem_marketing(user['name'])
    print(f"Mensagem gerada: {mensagem}")
    
    # Anexar a mensagem à lista de 'news' em memória
    user['news'].append({
        "icon": "https://digitalinnovationone.github.io/santander-dev-week-2023-api/icons/credit.svg",
        "description": mensagem
    })
    
    time.sleep(1)

# ==========================================
# 3. LOAD (Carregamento no MongoDB)
# ==========================================

print("\n--- A atualizar registos no MongoDB ---")
for user in users:
    resultado = colecao.update_one(
        {"_id": user["_id"]},
        {"$set": {"news": user["news"]}}
    )
    print(f"Utilizador {user['name']} modificado? {resultado.modified_count > 0} (Modificados: {resultado.modified_count})")

# Encerramento formal da ligação
cliente.close()
print("\nPipeline ETL finalizado com sucesso!")
